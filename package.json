{
  "name": "@stefanobalocco/opencode-advisor",
  "version": "2.2.1",
  "description": "OpenCode plugin — advisor() tool via a hidden internal agent",
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": "./plugin.js"
  },
  "scripts": {
    "build": "node build.mjs all",
    "build:plugin": "node build.mjs plugin",
    "build:tests": "node build.mjs tests",
    "tests": "c8 --include=plugin.ts --exclude-after-remap --per-file --100 --reporter=text --reporter=lcov ava '*.test.js' --verbose"
  },
  "files": [
    "plugin.js"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "advisor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StefanoBalocco/opencode-advisor.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-ai/plugin": ">=1.4.9"
  },
  "devDependencies": {
    "typescript": "~6",
    "ava": "~6",
    "c8": "~12",
    "@opencode-ai/sdk": ">=1.4.9",
    "@types/node": "^24.13.3"
  }
}
